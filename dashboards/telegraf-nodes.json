{
  "id": null,
  "uid": "clustered-telegraf-nodes",
  "title": "Telegraf \u2014 Clustered Lab Nodes",
  "description": "Live node metrics from the telegraf database via read-only InfluxQL. Filesystem peak is the maximum in the selected time range; counters are per-second rates.",
  "tags": [
    "telegraf",
    "clustered",
    "lab"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "editable": true,
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "${DS_CLUSTERED_TELEGRAF}"
        },
        "query": "SHOW TAG VALUES FROM \"cpu\" WITH KEY = \"host\"",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU busy",
      "type": "bargauge",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_CLUSTERED_TELEGRAF}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_CLUSTERED_TELEGRAF}"
          },
          "rawQuery": true,
          "query": "SELECT 100 - last(\"usage_idle\") AS \"busy\" FROM \"cpu\" WHERE $timeFilter AND \"host\" =~ /^${host:regex}$/ AND \"cpu\" = 'cpu-total' GROUP BY \"host\"",
          "resultFormat": "time_series",
          "alias": "$tag_host"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1,
          "noValue": "No recent samples",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "sizing": "auto",
        "minVizHeight": 24,
        "maxVizHeight": 42,
        "text": {
          "titleSize": 13,
          "valueSize": 20
        }
      },
      "description": "One usage bar per selected host. Green below 75%, amber at 75%, red at 90%. Latest observed value in the selected time range.",
      "transparent": false,
      "pluginVersion": "12.1.1"
    },
